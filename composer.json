{
    "name": "naluz/installer",
    "description": "The NaluzPHP installer: create new NaluzPHP projects with `naluz new my-app`.",
    "type": "library",
    "license": "MIT",
    "keywords": ["naluz", "naluzphp", "installer", "framework", "cli"],
    "homepage": "https://github.com/taliffsss/naluz-installer",
    "authors": [
        {
            "name": "Mark Anthony Naluz",
            "email": "anthony.naluz15@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Naluz\\Installer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Naluz\\Installer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/naluz"
    ],
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --runtime-set ignore_warnings_on_exit 1"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
